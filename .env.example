# ─── Supabase (client-side) ───────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Supabase (server-side) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ─── WhatsApp — Green API ─────────────────────────────────────
# Register free at green-api.com → create instance → scan QR
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
